# Cloudflare Tunnel Configuration Template for IBIS Payment Server
# Save this file to: C:\Users\<YourUsername>\.cloudflared\config.yml
# Or add the ingress rule below to your existing tunnel configuration

tunnel: YOUR_TUNNEL_UUID_HERE
credentials-file: C:\Users\<YourUsername>\.cloudflared\YOUR_TUNNEL_UUID_HERE.json

ingress:
  # App 1: IBIS Procurement & Payment System
  - hostname: payment.icsserver.com
    service: http://localhost:3000

  # App 2 (Optional): Document Manager (if co-hosted on same PC)
  # - hostname: goo.icsserver.com
  #   service: http://localhost:8000

  # Catch-all fallback rule (REQUIRED by Cloudflare)
  - service: http_status:404
