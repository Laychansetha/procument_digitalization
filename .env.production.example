# =============================================================================
# IBIS Rice Procurement System — Production Environment Configuration
# Target Subdomain: procurment.icsserver.com
# Amazon Lightsail VPS (Amazon Linux 2023)
# =============================================================================

# PostgreSQL Database Connection String
# Points to PostgreSQL instance on Lightsail (localhost or private internal IP)
DATABASE_URL="postgresql://dbmasteruser:YOUR_POSTGRESQL_PASSWORD@localhost:5432/ibis_db?schema=public"

# NextAuth Authentication Configuration
NEXTAUTH_URL="https://procurment.icsserver.com"

# Generate a strong 64-character secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_64_CHAR_SECRET"

# Node Application Server Settings
PORT=3000
HOSTNAME="0.0.0.0"
