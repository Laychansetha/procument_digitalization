# ======================================================================
# IBIS RICE SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================================
# Copy this file to .env and fill in your local values:
#   cp .env.example .env    (Linux/macOS)
#   copy .env.example .env  (Windows)
#
# NEVER commit the .env file — it contains real secrets.
# ======================================================================

# 1. PostgreSQL Database Connection String
#    Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
#    Replace the placeholders with your actual PostgreSQL credentials.
DATABASE_URL="postgresql://postgres:<YOUR_DB_PASSWORD>@localhost:5432/ibis_db?schema=public"

# 2. Server Network Configuration
PORT=3000
HOSTNAME="0.0.0.0"

# 3. NextAuth Authentication
#    NEXTAUTH_SECRET: generate a strong random string, e.g.:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="<generate-a-secure-random-string>"
NEXTAUTH_URL="http://localhost:3000"

# 4. Optional: File Upload Directory (relative path from project root)
UPLOAD_DIR="./public/uploads"
