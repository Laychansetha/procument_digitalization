# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Node.js dependencies ─────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ─── Next.js build output ─────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── TypeScript build info ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Prisma generated client ──────────────────────────────────────────────────
/src/generated/prisma

# ─── Local databases (never commit local DB files) ────────────────────────────
prisma/*.db
prisma/*.db-shm
prisma/*.db-wal
prisma/*.db-journal
*.sqlite
*.sqlite3

# ─── Environment / secrets (NEVER commit real .env files) ─────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
# Allow .env.example so developers can get the template
!.env.example

# ─── Android / Flutter build artifacts ────────────────────────────────────────
*.apk
*.aab
*.keystore
*.jks

# ─── Deployment packages (large zip archives) ─────────────────────────────────
*.zip

# ─── Bundled / embedded JDK (never commit JDK binaries) ──────────────────────
/jdk-17/
/jdk-17-real/

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS-specific files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── SSL / PEM certificates ───────────────────────────────────────────────────
*.pem
*.crt
*.key

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── IDE / editor config folders (machine-specific symlinks / settings) ───────
.claude/
.windsurf/

# ─── Antigravity IDE internal lock file ───────────────────────────────────────
skills-lock.json
