# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Node.js dependencies ─────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ─── Next.js build output ─────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── TypeScript build info ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Prisma generated client ──────────────────────────────────────────────────
/src/generated/prisma

# ─── Local databases (never commit local DB files) ────────────────────────────
prisma/*.db
prisma/*.db-shm
prisma/*.db-wal
prisma/*.db-journal
*.sqlite
*.sqlite3

# ─── Environment / secrets (NEVER commit real .env files) ─────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
# Allow .env.example and .env.production.example template
!.env.example
!.env.production.example

# ─── Runtime User Uploads ─────────────────────────────────────────────────────
/public/uploads/*
!/public/uploads/.gitkeep

# ─── Android / Flutter build artifacts ────────────────────────────────────────
*.apk
*.aab
*.keystore
*.jks
field_app/android/app/build/
field_app/build/
field_app/.dart_tool/

# ─── Windows Development Batch & PowerShell Scripts ───────────────────────────
*.bat
create-app-icons.ps1
scripts/setup-jdk.ps1

# ─── Local Data & Reference Spreadsheets ──────────────────────────────────────
*.xlsx
username_roles.csv

# ─── Local Scratch / Test Scripts & Obsolete Guides ───────────────────────────
scripts/check*
scripts/test*
DEPLOYMENT_DESKTOP_GUIDE.md
README_DESKTOP_DEPLOYMENT.md
VPS_SETUP_GUIDE.md
cloudflared_config.yml.example

# ─── Deployment packages (large zip archives) ─────────────────────────────────
*.zip

# ─── Bundled / embedded JDK (never commit JDK binaries) ──────────────────────
/jdk-17/
/jdk-17-real/

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS-specific files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── SSL / PEM certificates ───────────────────────────────────────────────────
*.pem
*.crt
*.key

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── IDE / editor config folders (machine-specific symlinks / settings) ───────
.claude/
.windsurf/
.agents/

# ─── Antigravity IDE internal lock file ───────────────────────────────────────
skills-lock.json
