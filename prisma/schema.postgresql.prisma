datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FIELD
  WAREHOUSE
  INVENTORY
  FINANCE
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(FIELD)
  assignedProvinces String?   @default("Preah Vihear,Stung Treng,Ratanakiri,Mondulkiri")
  status            String    @default("ACTIVE")
  lastLogin         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  farmerProfiles  FarmerProfile[]
  specsRecords    SpecsRecord[]
  purchaseRecords PurchaseRecord[]
  transportRecs   TransportRecord[]
  auditLogs       AuditLog[]
}

model Village {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  district  String?
  province  String?  @default("Preah Vihear")
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
}

model Bank {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
}

model LocationRegistry {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // BUYING_STATION, WAREHOUSE, EXPORT_TERMINAL
  code      String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model FleetVehicle {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  driverName  String
  driverPhone String?
  maxWeightKg Float?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}

model PaddyPriceSpec {
  id               String   @id @default(cuid())
  variety          String
  grade            String
  basePrice        Float    // KHR/kg
  maxMoisture      Float    @default(14.0) // Max allowed moisture %
  maxForeignMatter Float    @default(5.0)  // Max allowed foreign matter %
  minWholeGrain    Float?   @default(70.0) // Min whole grain %
  maxBrokenRice    Float?   @default(30.0) // Max broken rice %
  impurity         Float?   // Impurity %
  moistureRange    String?  // Moisture Range string e.g. "13 - 14"
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([variety, grade])
}

model FarmerProfile {
  id               String    @id @default(cuid())
  familyCode       String
  farmerName       String
  village          String
  phone            String?
  paymentMethod    String    @default("Bank Transfer")
  bankName         String?
  accountNumber    String?
  accountHolder    String?
  relationship     String    @default("Self")
  bankDocumentUrl  String?   // Photo of actual bank paper to prevent typos
  notes            String?
  createdBy        String
  user             User      @relation(fields: [createdBy], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([familyCode])
  @@index([farmerName])
}

model SpecsRecord {
  id                   String    @id @default(cuid())
  date                 DateTime  @default(now())
  familyCode           String
  farmerName           String
  village              String
  paddyType            String
  selectedGrade        String
  isOrganic            Boolean   @default(true)
  moisture             Float
  foreignMatter        Float
  purity               Float?
  impurity             Float?
  wholeGrain           Float?
  brokenRice           Float?
  isValid              Boolean
  basePrice            Float
  finalPrice           Float
  bestQualifyingGrade  String?
  createdBy            String
  user                 User      @relation(fields: [createdBy], references: [id])
  createdAt            DateTime  @default(now())

  @@index([familyCode])
  @@index([farmerName])
}

model PurchaseRecord {
  id                  String           @id @default(cuid())
  date                DateTime         @default(now())
  familyCode          String
  farmerName          String
  village             String
  totalWeight         Float
  totalPayment        Float
  seedBorrowed        Float            @default(0)
  seedRepayment       Float            @default(0)
  seedDeduction       Float            @default(0)
  additionalPremium   Float            @default(0)
  netPayment          Float
  signatureFarmer     String?          // Digital electronic signature of farmer
  signatureStaff      String?          // Staff signature / verification
  purchasingStaffId   String?          // ID of purchasing staff member for accountability
  purchasingStaffName String?          // Name of purchasing staff member
  specsRecordId       String?          // Linked Specs Record ID to prevent duplicate entry
  transportRecordId   String?          // Linked Transport Record ID once loaded on a truck
  transportRecord     TransportRecord? @relation(fields: [transportRecordId], references: [id])
  status              String           @default("PENDING") // PENDING, IN_TRANSIT, RECEIVED, VERIFIED, DISBURSED
  createdBy           String
  user                User             @relation(fields: [createdBy], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  items               PurchaseItem[]

  @@index([familyCode])
  @@index([farmerName])
}

model PurchaseItem {
  id              String         @id @default(cuid())
  purchaseId      String
  purchase        PurchaseRecord @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variety         String
  grade           String
  standardPrice   Float
  additionalPrice Float          @default(0) // Extra transport, ferry, or distance premium per kg
  finalPrice      Float
  sacks           Int
  quantity        Float
  totalValue      Float
  sackWeights     String?        // JSON array string of individual sack weights e.g. "[100.0, 100.0, 100.0]"
}

model TransportRecord {
  id                   String           @id @default(cuid())
  date                 DateTime         @default(now())
  driverName           String
  plateNumber          String
  mobileNumber         String?
  truckCleaned         Boolean          @default(false)
  fieldStaffName       String?
  fieldStaffDate       String?
  fieldStaffTime       String?
  driverWitnessName    String?
  driverWitnessDate    String?
  driverWitnessTime    String?
  loadingLocation      String?          @default("Chhaeb Buying Station")
  destinationWarehouse String?          @default("CACC (KPT)")
  notes                String?
  totalSacks           Int
  totalFieldWeight     Float
  status               String           @default("EN_ROUTE") // EN_ROUTE, ARRIVED, RECEIVED, VERIFIED
  createdBy            String
  user                 User             @relation(fields: [createdBy], references: [id])
  createdAt            DateTime         @default(now())
  lots                 TransportLot[]
  purchases            PurchaseRecord[]
  intake               WarehouseIntake?
}

model TransportLot {
  id               String          @id @default(cuid())
  transportId      String
  transport        TransportRecord @relation(fields: [transportId], references: [id], onDelete: Cascade)
  variety          String
  familyCode       String
  farmerName       String?
  village          String
  sacks            Int
  weight           Float
  purchaseRecordId String?
}

model WarehouseIntake {
  id                   String          @id @default(cuid())
  transportId          String          @unique
  transport            TransportRecord @relation(fields: [transportId], references: [id], onDelete: Cascade)
  arrivalTime          DateTime        @default(now())
  warehouseGrossWeight Float
  warehouseTareWeight  Float
  warehouseNetWeight   Float
  weightDiffKg         Float
  weightDiffPercent    Float?          @default(0)
  grossScalePhotoUrl   String?         // Photo of Gross Weight scale display indicator
  tareScalePhotoUrl    String?         // Photo of Tare Weight scale display indicator
  transportInvoiceUrl  String?         // Photo of Truck Transport Invoice for Finance payment verification
  receivingStaffId     String
  receivingStaffName   String?
  notes                String?
  inventoryStatus      String    @default("WAITING_FOR_INVENTORY") // WAITING_FOR_INVENTORY, INVENTORY_RECORDED
  inventoryStaffId     String?
  inventoryStaffName   String?
  inventoryConfirmedAt DateTime?
  inventoryLocation    String?   // Storage location e.g. Silo 02, Stack A, Bay 4
  inventoryNotes       String?
  status               String    @default("RECEIVED")
  createdAt            DateTime        @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  userName   String
  userRole   Role
  action     String   // CREATE, UPDATE, DELETE, DISBURSE, INTAKE, CONFIG
  entityType String   // SpecsRecord, FarmerProfile, PurchaseRecord, TransportRecord, WarehouseIntake, Village, Bank, PaddyPriceSpec
  entityId   String
  details    String?  // JSON string
  ipAddress  String?
  timestamp  DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string storing configuration settings
  updatedAt DateTime @updatedAt
}
